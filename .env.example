# ==============================================================================
# CONFIGURACIÓN GENERAL DEL SISTEMA AZPRO (DESARROLLO Y PRODUCCIÓN)
# ==============================================================================

# Nombre de la aplicación
APP_NAME="Sistema AZPRO Condominios"
# Entorno: 'production' para servidor final, 'local' para desarrollo
APP_ENV=production
# Clave secreta generada con: php artisan key:generate
APP_KEY=
# Modo Depuración: 'false' en Producción (OBLIGATORIO por seguridad), 'true' en Local
APP_DEBUG=false
# URL base pública del sitio (ej. https://micondominio.com)
APP_URL=https://micondominio.com
# Forzar esquema HTTPS en producción ('true' o 'false')
FORCE_HTTPS=true

# Idioma y zona horaria
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE
APP_TIMEZONE=America/Caracas

# Log del sistema
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ==============================================================================
# BASE DE DATOS (PostgreSQL, MySQL o SQLite)
# ==============================================================================
# Para PostgreSQL en Producción:
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=condominiosaas
DB_USERNAME=postgres
DB_PASSWORD=secret

# Para MySQL / MariaDB en Producción (Descomentar si usas MySQL):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=condominiosaas
# DB_USERNAME=root
# DB_PASSWORD=secret

# ==============================================================================
# SESIÓN Y ALMACENAMIENTO DE ARCHIVOS
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ==============================================================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO (SMTP)
# ==============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notificaciones@azpro.com
MAIL_PASSWORD=tu_clave_de_aplicacion
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notificaciones@azpro.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# INTEGRACIÓN FRONTEND VITE
# ==============================================================================
VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL=/api/v1
